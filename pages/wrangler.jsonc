// The arena on Cloudflare (src/host.js). Public settings are vars; the season secret and the judge's
// key are Worker secrets (`wrangler secret put SECRET` / `JUDGE_KEY --env <name>`), never written here.
// Local run against a local node: `wrangler dev --env-file <file>` with RPC_URL, CHAIN_ID, ARENA,
// DECOYS and SECRET in that file (kept outside the project).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibiti-agent-arena",
  "main": "src/host.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "html_handling": "none",
    // the HTML pages get their link-preview tags from the Worker; every other file is served as is
    "run_worker_first": ["/", "/*.html"]
  },
  // logs never keep a request's query string (a fighter's page key travels there) and no
  // per-request invocation logs are kept: only what the code itself logs (the judge's lines)
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
  // each visitor's reads through /rpc: the site polls every 2 s with a few calls; far more is not a viewer
  "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  // the judge: every minute it scores the fights that are over (src/judge-cron.js)
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ROUND_TIME": 60,
    "DEPLOY_BLOCK": 0,
    "BLOCKS_PER_WEEK": 604800
  },
  "env": {
    // the rehearsal on BNB Smart Chain Testnet (chain 97). Its judge is the rehearsal wallet; the key
    // and the season secret are uploaded as secrets from outside the project (--secrets-file).
    "testnet": {
      "name": "ibiti-agent-arena-testnet",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
      "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
      "vars": {
        // publicnode: the only public testnet node that serves logs over wide block ranges
        "RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "CHAIN_ID": 97,
        // earlier arenas of this site: their fights stay readable by links that name them
        "ARCHIVE": [{ "arena": "0x5AF4f168dF8129437f51C509867c7B41C0950353", "season": 4, "plan": 11, "deployBlock": 144288958, "certificate": "0x70F4b6b12aFDa9Fd0cECbf89E838b8c1f2e750c5", "decoys": {"13":"0xBC743dc9bB09278d1bdfB2534629dE8Ca2F877DF","15":"0xA4486645e71fA97a4714106E93EcC8b97e4DE031","18":"0x3b1DAA6B3915e2e3B11f4f283b20a5B7Ad3dD12d","21":"0x4Bc87950F50f317b7C6932a2B3f9bA2d30573Da4","22":"0x9aB22Ed331E892Fb0aAF46F0D45FFD3a9E7aF10D","23":"0xdBab55CDdEB4c7F22D45b39232cA7933390A3558","24":"0xf73D7270446C981FA653A5Ac5cd8f9Ba8e0Cb829","26":"0x9090E9DFF5BFa8D5F963a64AA16154D427f597D2","27":"0x4903d8Daf1aD8d0cde01C0f9D137f1BF79132649"} }, { "arena": "0xF09FF6CeBd45999847ad84D3170928d1e1d8c90e", "season": 3, "plan": 10, "deployBlock": 144286208, "certificate": "0x23f5A86066FD079Fc672760D52eDF02F60047919", "decoys": {"13":"0xB548422318B9fCD2F202fC7C29d5F2E79167073a","15":"0x584c5Af287b416e3ADe8eD59E7A67331fBF4F786","18":"0xf520B0d56dc5eA8e3180D790069A0044cAEe24d2","21":"0xA0E81F596Cbc73fF9F2949D41D8fb1beA2f0A124","22":"0xA21151B4BDef3C59D0fc04477A1931C272B736a5","23":"0xdD7180AD31699FEde6F0803eBfBd0684aFabAf76","24":"0x4be151760c95a557233b281e547346F2c10e2152","26":"0xAe5554E756f6F3Cbfc926AA2ff5fD91e743630FC","27":"0x5F01aDf1983E71C70cF7f628d791460adbc49788"} }, { "arena": "0x270AC84667B4992C72369843bd141702d804a43C", "season": 2, "plan": 7, "deployBlock": 144213945, "certificate": "0x2B67588B385B9B429A9137D368E5B615d417AAaf", "decoys": {"13":"0xb629fB2b6ca32E21fb06467e905CB10009F0f787","15":"0x7C517758754D69600e4d60e64Ef305F61616e669","18":"0x1EBc643f26F173372f15497cc0F27693ABd18514","21":"0xd837218dB771F7cfF8977e924130a97c4586b377","22":"0xa9772CDa390BBE9AF9B34A86c04a562123291F6C","23":"0xDF111209587433a88daA6B802125C12A8E760646","24":"0xdFeCF3CF2E7041a9861dda6Ee4bE6df085B07e5b","26":"0x3Ad41BF8575898bD18E244A4f2a4a2b4E22cff49","27":"0x663b00b1b80BBE00e450fEaAb4C6487b0eCca7d0"} }, { "arena": "0x8080D34E5Ec0f91E8ed76Ef4d07b36Db8a32991f", "season": 1, "plan": 6, "deployBlock": 144116164, "certificate": "0xd239F9FC04303eE9CA6CB28755F093C40063c0c4", "decoys": {"13":"0x2a337235527eC38400A837591e928d4402a20ee7","15":"0xA2C51B9115A4312Ab7836B751b55878a0d893FD5","18":"0x3702C5e2bdD3E8cb86F638E5d8A667f2047BfbDD","21":"0x5154B5CDbc784aF43f673C3737d56C82067Bf125","22":"0xc41bbd20771f7D8Bc80C22E426E4725BE9D4da54","23":"0x8A38f5Ef6D4d985104772ae098FD4D7fE9CAF47A","24":"0xD949f6bDdfd6d677b3090c438fd8C8746ae41a26","26":"0x11a703B6153ECDE8DCCE65C3Dfd64e5e5894e7A9","27":"0x67bb6275326F5E3e188B09D8B89004aEb4d84C3C"} }, { "arena": "0x4984B4C6050ec3289907cfeb591E1f6a6Aa906ee", "plan": 6, "deployBlock": 144108862, "certificate": "0x09DA8087Ef6c8A7D35d1D675618A17A9FBB9304F", "decoys": {"13":"0xE291E72C560959bcd0648c28085D267cb72b9A74","15":"0x0D0319a95A291e67C4DD3026CF8781aaeF33876E","18":"0x2B165cD278492D100F4Ca05eD1F984b77C1309A8","21":"0x49C2E652653e5A209551037A2B7cF9285D06Fa65","22":"0x6EC7727122D5017FAB1a3C60248aC1C9b109E922","23":"0xAc2E8B51976E0cF3ca26A899B5a2c5E8180CB97c","24":"0xEfa39cDd4f1b2feB709bd7c30c23eDDA58Bb5152","26":"0x91e12A0a69eDC4f37047Eaa51F9ACe77F25a1042","27":"0x773881f4D2aF8A2CA78AB96f1961C1bfBFDf0A85"} }],
        "ARENA": "0xA59F29A148dcCe8f071187794d628C85A79385b2",
        // the season calendar and each season's task set and certificate contract (seasons.js)
        "SEASON_BOOK": "0x9d1c131FF333f3874194243eF54c60c5892d2275",
        "SEASONS": { "1": { "plan": 11, "certificate": "0xBC49449A3144148A4d4602D116f2e1Ed6f2cdA15" } },
        // the two rings: this one (red, the season) and the green one (free fights, new tasks)
        "RING": "red",
        "RINGS": { "red": "https://ibiti-agent-arena-testnet.drainshieldguard.workers.dev", "green": "https://ibiti-agent-arena-testnet-green.drainshieldguard.workers.dev" },
        "DECOYS": {
          "13": "0xC0eE501EF27581BdD24Ff131846eD65039945D93",
          "15": "0x84b98c4351CFAA839782E111BD2c5ee675856a60",
          "18": "0xa086b39Fd78Bfc686D34730833A0c593D7C5aA73",
          "21": "0xD1BF4427aF3C139662f746Fd8461652753480b56",
          "22": "0x8ff6dE33f6B1CBaDad05d056796459f83f7885A8",
          "23": "0xb2dA224FDEa78956013dD990d7a5210f3945f96D",
          "24": "0xf846Dcf75832286BFa16481de7CC67d25fAbCAC7",
          "26": "0x689c7773a582015F18969C663b47b84ca7221377",
          "27": "0x241cF8286c617A0A163A35db087E2d7162980aab"
        },
        "DEPLOY_BLOCK": 144308232,
        // blocks come every 0.45 s on the testnet (measured 2026-11-21: 2000 blocks in 901 s)
        "BLOCKS_PER_WEEK": 1342500,
        "ROUND_TIME": 60
      }
    },
    // the green ring on the testnet: free fights, challenges allowed, the workshop deck (new tasks on
    // trial). Its own arena, judge (a second rehearsal wallet: two judges never share a nonce) and secret.
    "testnet-green": {
      "name": "ibiti-agent-arena-testnet-green",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
      "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }],
      "vars": {
        "RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "CHAIN_ID": 97,
        "ARENA": "0x9807e591fd4a04a7c4997aCf4747a4188BCc44CD",
        // the season calendar and each season's task set and certificate contract (seasons.js)
        "SEASON_BOOK": "0x7c77908683510DE36B4269F238b2955c29f3d6c5",
        "SEASONS": { "1": { "plan": 11, "certificate": "0xcAc0D56C165A352580fB0768f58c89593514Bd6D" } },
        "RING": "green",
        "RINGS": { "red": "https://ibiti-agent-arena-testnet.drainshieldguard.workers.dev", "green": "https://ibiti-agent-arena-testnet-green.drainshieldguard.workers.dev" },
        "DECK": "workshop",
        "CHALLENGES": "open",
        "DECOYS": {
          "13": "0x6B48A3226842304eb42c38b4A262eea11C3d4669",
          "15": "0x47cCE279b1DD1fAcC1ED8bb0455D8C90eA72a8e4",
          "18": "0x43906C81CC5478e876aEC3D7B36f5261A7f15804",
          "21": "0x527b0257B8DC3b6EFdec9717a5A5f634a8ed1968",
          "22": "0xb28Ae8Fbc6212c5CE82449a485B0d8Da6bC79C86",
          "23": "0xe8B2735082Aa7AC6Cbb2ccF2b028ad3fD096B62A",
          "24": "0x7bef7e8B47d0f4594AAeD59e67f881ebc2adDa31",
          "26": "0xbE2E77e0cA65553beb2cEd24c7e12e1233F627BE",
          "27": "0xc77A947D8CFB0eFC8cDcD737dCC21F66cda8461F"
        },
        "DEPLOY_BLOCK": 144308503,
        "BLOCKS_PER_WEEK": 1342500,
        "ROUND_TIME": 60
      }
    }
  }
}
