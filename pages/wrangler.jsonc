// The arena on Cloudflare (src/host.js). Public settings are vars; the season secret and the judge's
// key are Worker secrets (`wrangler secret put SECRET` / `JUDGE_KEY --env <name>`), never written here.
// Local run against a local node: `wrangler dev --env-file <file>` with RPC_URL, CHAIN_ID, ARENA,
// DECOYS and SECRET in that file (kept outside the project).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibiti-agent-arena",
  "main": "src/host.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "html_handling": "none",
    // the HTML pages get their link-preview tags from the Worker; every other file is served as is
    "run_worker_first": ["/", "/*.html"]
  },
  // logs never keep a request's query string (a fighter's page key travels there) and no
  // per-request invocation logs are kept: only what the code itself logs (the judge's lines)
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
  // each visitor's reads through /rpc: the site polls every 2 s with a few calls; far more is not a viewer
  "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  // the judge: every minute it scores the fights that are over (src/judge-cron.js)
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ROUND_TIME": 60,
        "HALL_HOLD": 40,
    "DEPLOY_BLOCK": 0,
    "BLOCKS_PER_WEEK": 604800
  },
  "env": {
    // the rehearsal on BNB Smart Chain Testnet (chain 97). Its judge is the rehearsal wallet; the key
    // and the season secret are uploaded as secrets from outside the project (--secrets-file).
    "testnet": {
      "name": "ibiti-agent-arena-testnet",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
      "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
      "vars": {
        // publicnode: the only public testnet node that serves logs over wide block ranges
        "RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "CHAIN_ID": 97,
        // earlier arenas of this site: their fights stay readable by links that name them
        "ARCHIVE": [{"arena": "0xBad6ED234a6a0233f16f7F24a0eE8469418e75f3", "season": 1, "plan": 12, "deployBlock": 144317303, "certificate": "0x921F953eAd29754EA17FE8eea8ba6689eD4b44b2", "decoys": {"13": "0xFa7624A10e8fAEFCf4521A80538bD7AEc59cDe1a", "15": "0x3c475F80b05123e1e6DF2F863F48DC7F209e306A", "18": "0xDa6c5719c3d04a93Dc7b59Ca5bAe66f01958Aae0", "21": "0x85473B2C7be7B3290a81bB7AA2B97A1d7e49cC2D", "22": "0xb8f25c59Ea223a842C7591CE7afe4AF1c5E21231", "23": "0x5BC004E520071B78669EE44daDd60e61333aBf0B", "24": "0x378af7628008D9A7E0089724cAB0D4D18EF6DC75", "26": "0xc6Ab7451175563269068A7FF9B07c81778f286a4", "27": "0x599Ca9dB0FA5a23037fBAEC54e4745B8f046070b"}}, {"arena": "0xA59F29A148dcCe8f071187794d628C85A79385b2", "season": 5, "plan": 11, "deployBlock": 144308232, "certificate": "0xBC49449A3144148A4d4602D116f2e1Ed6f2cdA15", "decoys": {"13": "0xC0eE501EF27581BdD24Ff131846eD65039945D93", "15": "0x84b98c4351CFAA839782E111BD2c5ee675856a60", "18": "0xa086b39Fd78Bfc686D34730833A0c593D7C5aA73", "21": "0xD1BF4427aF3C139662f746Fd8461652753480b56", "22": "0x8ff6dE33f6B1CBaDad05d056796459f83f7885A8", "23": "0xb2dA224FDEa78956013dD990d7a5210f3945f96D", "24": "0xf846Dcf75832286BFa16481de7CC67d25fAbCAC7", "26": "0x689c7773a582015F18969C663b47b84ca7221377", "27": "0x241cF8286c617A0A163A35db087E2d7162980aab"}}, {"arena": "0x5AF4f168dF8129437f51C509867c7B41C0950353", "season": 4, "plan": 11, "deployBlock": 144288958, "certificate": "0x70F4b6b12aFDa9Fd0cECbf89E838b8c1f2e750c5", "decoys": {"13": "0xBC743dc9bB09278d1bdfB2534629dE8Ca2F877DF", "15": "0xA4486645e71fA97a4714106E93EcC8b97e4DE031", "18": "0x3b1DAA6B3915e2e3B11f4f283b20a5B7Ad3dD12d", "21": "0x4Bc87950F50f317b7C6932a2B3f9bA2d30573Da4", "22": "0x9aB22Ed331E892Fb0aAF46F0D45FFD3a9E7aF10D", "23": "0xdBab55CDdEB4c7F22D45b39232cA7933390A3558", "24": "0xf73D7270446C981FA653A5Ac5cd8f9Ba8e0Cb829", "26": "0x9090E9DFF5BFa8D5F963a64AA16154D427f597D2", "27": "0x4903d8Daf1aD8d0cde01C0f9D137f1BF79132649"}}, {"arena": "0xF09FF6CeBd45999847ad84D3170928d1e1d8c90e", "season": 3, "plan": 10, "deployBlock": 144286208, "certificate": "0x23f5A86066FD079Fc672760D52eDF02F60047919", "decoys": {"13": "0xB548422318B9fCD2F202fC7C29d5F2E79167073a", "15": "0x584c5Af287b416e3ADe8eD59E7A67331fBF4F786", "18": "0xf520B0d56dc5eA8e3180D790069A0044cAEe24d2", "21": "0xA0E81F596Cbc73fF9F2949D41D8fb1beA2f0A124", "22": "0xA21151B4BDef3C59D0fc04477A1931C272B736a5", "23": "0xdD7180AD31699FEde6F0803eBfBd0684aFabAf76", "24": "0x4be151760c95a557233b281e547346F2c10e2152", "26": "0xAe5554E756f6F3Cbfc926AA2ff5fD91e743630FC", "27": "0x5F01aDf1983E71C70cF7f628d791460adbc49788"}}, {"arena": "0x270AC84667B4992C72369843bd141702d804a43C", "season": 2, "plan": 7, "deployBlock": 144213945, "certificate": "0x2B67588B385B9B429A9137D368E5B615d417AAaf", "decoys": {"13": "0xb629fB2b6ca32E21fb06467e905CB10009F0f787", "15": "0x7C517758754D69600e4d60e64Ef305F61616e669", "18": "0x1EBc643f26F173372f15497cc0F27693ABd18514", "21": "0xd837218dB771F7cfF8977e924130a97c4586b377", "22": "0xa9772CDa390BBE9AF9B34A86c04a562123291F6C", "23": "0xDF111209587433a88daA6B802125C12A8E760646", "24": "0xdFeCF3CF2E7041a9861dda6Ee4bE6df085B07e5b", "26": "0x3Ad41BF8575898bD18E244A4f2a4a2b4E22cff49", "27": "0x663b00b1b80BBE00e450fEaAb4C6487b0eCca7d0"}}, {"arena": "0x8080D34E5Ec0f91E8ed76Ef4d07b36Db8a32991f", "season": 1, "plan": 6, "deployBlock": 144116164, "certificate": "0xd239F9FC04303eE9CA6CB28755F093C40063c0c4", "decoys": {"13": "0x2a337235527eC38400A837591e928d4402a20ee7", "15": "0xA2C51B9115A4312Ab7836B751b55878a0d893FD5", "18": "0x3702C5e2bdD3E8cb86F638E5d8A667f2047BfbDD", "21": "0x5154B5CDbc784aF43f673C3737d56C82067Bf125", "22": "0xc41bbd20771f7D8Bc80C22E426E4725BE9D4da54", "23": "0x8A38f5Ef6D4d985104772ae098FD4D7fE9CAF47A", "24": "0xD949f6bDdfd6d677b3090c438fd8C8746ae41a26", "26": "0x11a703B6153ECDE8DCCE65C3Dfd64e5e5894e7A9", "27": "0x67bb6275326F5E3e188B09D8B89004aEb4d84C3C"}}, {"arena": "0x4984B4C6050ec3289907cfeb591E1f6a6Aa906ee", "plan": 6, "deployBlock": 144108862, "certificate": "0x09DA8087Ef6c8A7D35d1D675618A17A9FBB9304F", "decoys": {"13": "0xE291E72C560959bcd0648c28085D267cb72b9A74", "15": "0x0D0319a95A291e67C4DD3026CF8781aaeF33876E", "18": "0x2B165cD278492D100F4Ca05eD1F984b77C1309A8", "21": "0x49C2E652653e5A209551037A2B7cF9285D06Fa65", "22": "0x6EC7727122D5017FAB1a3C60248aC1C9b109E922", "23": "0xAc2E8B51976E0cF3ca26A899B5a2c5E8180CB97c", "24": "0xEfa39cDd4f1b2feB709bd7c30c23eDDA58Bb5152", "26": "0x91e12A0a69eDC4f37047Eaa51F9ACe77F25a1042", "27": "0x773881f4D2aF8A2CA78AB96f1961C1bfBFDf0A85"}}],
        "ARENA": "0x68D1560139d1c4d141422593f50a367dc0915A7a",
        // the season calendar and each season's task set and certificate contract (seasons.js)
        "SEASON_BOOK": "0x2eb6CA7b191fba4aeD7e985487A49059042bA57E",
        "SEASONS": { "1": { "plan": 12, "certificate": "0x7D56dB561FFc0FFa310bC513413d6592a74982a8" }, "2": { "plan": 12, "certificate": "0xb333615163dE46f45798057EE0374a923D88e490" } },
        // the two rings: this one (red, the season) and the green one (free fights, new tasks)
        "RING": "red",
        "RINGS": { "red": "https://ibiti-agent-arena-testnet.drainshieldguard.workers.dev", "green": "https://ibiti-agent-arena-testnet-green.drainshieldguard.workers.dev" },
        "DECOYS": {
          "13": "0x70Ef1f2d62c1A8E952044e4345204DDf3496ab87",
          "15": "0x4e64803f6bCFD7904C09cA68c8Ee4cfFB699a08E",
          "18": "0x3024dE5A76737973F0Eb45853393f0A599BFc90b",
          "21": "0x875009624fFc4C893C28ba3D7028f7e164489bC1",
          "22": "0x221E63D463E853FAc3316321a8Fbd710F589E159",
          "23": "0x5432ee8Cc83a594bE64d2e90703CB01A9aD3066B",
          "24": "0x53C97A8A0cC2e9090c9023390DA29CcbEEE0487D",
          "26": "0x8Aa0179143FF7554245336CC7Dc7255433eeD659",
          "27": "0x0f549A1D0a75CabdE8b799F675e685D1fAb15be0"
        },
        "DEPLOY_BLOCK": 144468952,
        // blocks come every 0.45 s on the testnet (measured 2026-11-21: 2000 blocks in 901 s)
        "BLOCKS_PER_WEEK": 1342500,
        "ROUND_TIME": 60,
        "HALL_HOLD": 40
      }
    },
    // the green ring on the testnet: free fights, challenges allowed, the workshop deck (new tasks on
    // trial). Its own arena, judge (a second rehearsal wallet: two judges never share a nonce) and secret.
    "testnet-green": {
      "name": "ibiti-agent-arena-testnet-green",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
      "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }],
      "vars": {
        "RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "CHAIN_ID": 97,
        "ARCHIVE": [{"arena": "0xc3551fa23Ca8c8A302e4Eb96FE3BC4Abcf7c611D", "season": 1, "plan": 12, "deployBlock": 144317405, "certificate": "0xD70C18636Fc1bf7a9fDe9cF1c21aa80aC0C58BD8", "decoys": {"13": "0xBbEe5B78b7f6115419cf4027be8EFf037095bbC8", "15": "0xA66a3400C38D38F702CB96386FF61CC983919C46", "18": "0x4cBb8aCD7924021ccbc72425DbbF71065c58Ee67", "21": "0x33736C4477DAf52dA239B8fd4C60Df7d3CdAF3ad", "22": "0x53b67Bc10d445dFA80D9f0D0DC3e9B0A4183f98C", "23": "0xEa7645D7f4642De02d4C4A1db46E0c67615ef830", "24": "0x14b5eb25841b3226E37Eac067f501083C4FE06Fa", "26": "0xAEA85616A73B2b7Bc5A14D492177763F56Df3b69", "27": "0x08eCCFF993784d373C076e6F0AD4C1A91982A2C7"}}, {"arena": "0x9807e591fd4a04a7c4997aCf4747a4188BCc44CD", "season": 1, "plan": 11, "deployBlock": 144308503, "certificate": "0xcAc0D56C165A352580fB0768f58c89593514Bd6D", "decoys": {"13": "0x6B48A3226842304eb42c38b4A262eea11C3d4669", "15": "0x47cCE279b1DD1fAcC1ED8bb0455D8C90eA72a8e4", "18": "0x43906C81CC5478e876aEC3D7B36f5261A7f15804", "21": "0x527b0257B8DC3b6EFdec9717a5A5f634a8ed1968", "22": "0xb28Ae8Fbc6212c5CE82449a485B0d8Da6bC79C86", "23": "0xe8B2735082Aa7AC6Cbb2ccF2b028ad3fD096B62A", "24": "0x7bef7e8B47d0f4594AAeD59e67f881ebc2adDa31", "26": "0xbE2E77e0cA65553beb2cEd24c7e12e1233F627BE", "27": "0xc77A947D8CFB0eFC8cDcD737dCC21F66cda8461F"}}],
        "ARENA": "0x2c86C0BF28348aEC2A9a1b6ed097f8afa9c29B43",
        // the season calendar and each season's task set and certificate contract (seasons.js)
        "SEASON_BOOK": "0x73f3ea89F476a1A3b5031cE5CaC71F9f4Df4a560",
        "SEASONS": { "1": { "plan": 12, "certificate": "0xdDA9df84Abf2c82b7a838ba4a87Cba3B9513AE1F" }, "2": { "plan": 12, "certificate": "0x50b8ad57C524A905c463D8630ca5DF6C3Ce8754a" } },
        "RING": "green",
        "RINGS": { "red": "https://ibiti-agent-arena-testnet.drainshieldguard.workers.dev", "green": "https://ibiti-agent-arena-testnet-green.drainshieldguard.workers.dev" },
        "DECK": "workshop",
        "CHALLENGES": "open",
        "DECOYS": {
          "13": "0x23dEB35d8751F623274Df811b643244138b3B4Ac",
          "15": "0x27753240C68b34Df0C762730D0449208cfb1F821",
          "18": "0xd413c2E0EBc52931f7Ed4bC3Fec2ea80aAaf21a1",
          "21": "0x2f6DC319902245F76bDD8C5b1087cBf443F9f5d0",
          "22": "0x8880D1ccb04C97532e9FD5350f7743b9E509b342",
          "23": "0x9f69f886198B4b754c54434bBd910e05261b000F",
          "24": "0x409606603af77389d0AADBD98Eb5915f88213197",
          "26": "0x92D817ba72C959A26b47B8002616D6Dc44B7E0D6",
          "27": "0xC403BB23e8b95FdfdaB55372a0a2FbedD9Fa53E5"
        },
        "DEPLOY_BLOCK": 144469054,
        "BLOCKS_PER_WEEK": 1342500,
        "ROUND_TIME": 60,
        "HALL_HOLD": 40
      }
    },
    // BNB Smart Chain mainnet (chain 56), the red ring: season 1 with its ranking and certificates. Its
    // judge key and season secret are Worker secrets, uploaded from outside the project.
    "mainnet": {
      "name": "ibiti-agent-arena",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
      "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }],
      // the arena's history (src/archive.js): one KV value per 5000 blocks of its logs and one per 50000,
      // written by the cron from the archive node only. One namespace (ibiti-arena-history) serves both
      // rings: every key names its arena.
      "kv_namespaces": [{ "binding": "HISTORY", "id": "d7d0f070d1844550af3ec42bbef63b06" }],
      "vars": {
        "RPC_URL": "https://bsc-dataseed.bnbchain.org",
        // the judge's and the fighters' nodes, in order (src/rpc.js): calls and sends start at the BNB
        // dataseeds (no failure measured from Cloudflare, but they serve no logs at all), logs go to
        // thirdweb (1000 blocks a request, an archive), then 48.club (250 blocks; an MEV relay, so it
        // never gets a transaction), publicnode last (it answers HTTP 429 to 50-80% of the requests from
        // Cloudflare: never depended on). Never list meowrpc (fake transaction hashes), drpc or blastapi.
        // Before adding a log node, check that a range past its head is an error there, not silently cut
        // short. "archive": true only for a node measured to keep every log since the deployment: the KV
        // archive is built from those alone, and a log range older than six hours goes only to them.
        "RPC_URLS": [
          { "url": "https://bsc-dataseed.bnbchain.org", "logs": 0, "send": true },
          { "url": "https://bsc-dataseed2.defibit.io", "logs": 0, "send": true },
          { "url": "https://56.rpc.thirdweb.com", "logs": 1000, "send": false, "archive": true },
          { "url": "https://rpc-bsc.48.club", "logs": 250, "send": false },
          { "url": "https://bsc-rpc.publicnode.com", "logs": 50000, "send": true }
        ],
        // the site's reads and link previews: other nodes first, so the audience spends no judge quota
        // (its calls are shared through the cache: see host.js); publicnode last
        "SITE_RPC_URLS": [
          { "url": "https://bsc-dataseed1.ninicoin.io", "logs": 0 },
          { "url": "https://rpc-bsc.48.club", "logs": 250 },
          { "url": "https://56.rpc.thirdweb.com", "logs": 1000, "archive": true },
          { "url": "https://bsc-rpc.publicnode.com", "logs": 50000 }
        ],
        // the viewers' own reads (site/assets/rpc-client.js): the pages poll these nodes straight from
        // the browser (each answers a browser: CORS open, batches accepted; measured 2026-11-24), so a
        // poll costs no Worker invocation; /rpc serves the history (KV archive) and the moments when no
        // node answers. Calls: the dataseeds (they serve no logs at all). Logs: 48.club (250 blocks a
        // request), thirdweb (1000, an archive; it rate-limits bursts per address), publicnode (50000,
        // but logs older than about 2 to 2.5 hours come back empty with no error: trusted for 1 hour).
        // "keep": the hours of logs a pruning node is trusted for (48.club answered in full 2.5 to 100 h
        // back, 4 tries each, 2026-11-24: 6 like the judge; publicnode empty from about 2.5 h).
        // At most one request per node every 2 s per viewer on average (a burst of 3).
        "BROWSER_RPC_URLS": [
          { "url": "https://bsc-dataseed.bnbchain.org", "calls": true, "logs": 0 },
          { "url": "https://bsc-dataseed2.defibit.io", "calls": true, "logs": 0 },
          { "url": "https://bsc-dataseed1.ninicoin.io", "calls": true, "logs": 0 },
          { "url": "https://rpc-bsc.48.club", "logs": 250, "keep": 6 },
          { "url": "https://56.rpc.thirdweb.com", "logs": 1000, "archive": true },
          { "url": "https://bsc-rpc.publicnode.com", "logs": 50000, "keep": 1 }
        ],
        // the judge's log reads in requests of 1000 blocks: one request on thirdweb, four on 48.club
        "LOG_UNIT": 1000,
        // the widest range the site's proxy asks the log nodes for at once (thirdweb: four requests);
        // the history beyond it comes from the archive
        "SITE_LOG_SPAN": 4000,
        // the judge's chain requests a run: Workers Free allows 50 subrequests an invocation (KV calls
        // included); the archive after it takes what is left, at most 16 (src/archive.js), and sends
        // the archive node at most 7 requests a minute, the judge's own counted
        "SUBREQ_BUDGET": 45,
        "CHAIN_ID": 56,
        "ARENA": "0xaC90EcF08C1429A00D4661C290d64b52c7f79536",
        "SEASON_BOOK": "0x4Fd093cBfF62c11d12292B3F6C9a8ce9ac6f823C",
        "SEASONS": { "1": { "plan": 12, "certificate": "0xc743d4Da2166B73c94B8aE6694c13F753E87023d" } },
        "RING": "red",
        "RINGS": { "red": "https://ibiti-agent-arena.drainshieldguard.workers.dev", "green": "https://ibiti-agent-arena-street.drainshieldguard.workers.dev" },
        "DECOYS": {
          "13": "0xe4C49F5aDC9285baFF54876e9063f6f09Fa81F79",
          "15": "0x3Bb2d763d6171b355F8110b7ad695773d9d1de92",
          "18": "0x5a72c8590BE049378bfb9ca1048D535DdF33004C",
          "21": "0xaea7910d15C460D7FA98b8dAce6a0B5B6a248fbd",
          "22": "0xd76A02232d5dACC3961696Ab771a6885f8AB9710",
          "23": "0x2c61103b135068305A4FbEDeC150a73dBE2E1Be1",
          "24": "0x8D40F7E56167201e97080936dA5172e40245250D",
          "26": "0x508074d96Bc6350C5464615F5F6FAf167268BbAF",
          "27": "0x7768F7eC4AB77fa59b74Fb3F1FF3ACB5F5fC1cFa"
        },
        "DEPLOY_BLOCK": 135473574,
        // blocks come every 0.45 s on mainnet too (measured 2026-11-24: 20000 blocks in 9003 s)
        "BLOCKS_PER_WEEK": 1343552,
        "ROUND_TIME": 60,
        "HALL_HOLD": 40
      }
    },
    // the Street Ring on mainnet (the green ring): a ranking and no award, challenges open, the
    // workshop deck. Its own arena, judge and secret.
    "mainnet-street": {
      "name": "ibiti-agent-arena-street",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
      "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } }],
      // the arena's history (src/archive.js): one KV value per 5000 blocks of its logs and one per 50000,
      // written by the cron from the archive node only. One namespace (ibiti-arena-history) serves both
      // rings: every key names its arena.
      "kv_namespaces": [{ "binding": "HISTORY", "id": "d7d0f070d1844550af3ec42bbef63b06" }],
      "vars": {
        "RPC_URL": "https://bsc-dataseed.bnbchain.org",
        // the judge's and the fighters' nodes, in order (src/rpc.js): calls and sends start at the BNB
        // dataseeds (no failure measured from Cloudflare, but they serve no logs at all), logs go to
        // thirdweb (1000 blocks a request, an archive), then 48.club (250 blocks; an MEV relay, so it
        // never gets a transaction), publicnode last (it answers HTTP 429 to 50-80% of the requests from
        // Cloudflare: never depended on). Never list meowrpc (fake transaction hashes), drpc or blastapi.
        // Before adding a log node, check that a range past its head is an error there, not silently cut
        // short. "archive": true only for a node measured to keep every log since the deployment: the KV
        // archive is built from those alone, and a log range older than six hours goes only to them.
        "RPC_URLS": [
          { "url": "https://bsc-dataseed.bnbchain.org", "logs": 0, "send": true },
          { "url": "https://bsc-dataseed2.defibit.io", "logs": 0, "send": true },
          { "url": "https://56.rpc.thirdweb.com", "logs": 1000, "send": false, "archive": true },
          { "url": "https://rpc-bsc.48.club", "logs": 250, "send": false },
          { "url": "https://bsc-rpc.publicnode.com", "logs": 50000, "send": true }
        ],
        // the site's reads and link previews: other nodes first, so the audience spends no judge quota
        // (its calls are shared through the cache: see host.js); publicnode last
        "SITE_RPC_URLS": [
          { "url": "https://bsc-dataseed1.ninicoin.io", "logs": 0 },
          { "url": "https://rpc-bsc.48.club", "logs": 250 },
          { "url": "https://56.rpc.thirdweb.com", "logs": 1000, "archive": true },
          { "url": "https://bsc-rpc.publicnode.com", "logs": 50000 }
        ],
        // the viewers' own reads (site/assets/rpc-client.js): the pages poll these nodes straight from
        // the browser (each answers a browser: CORS open, batches accepted; measured 2026-11-24), so a
        // poll costs no Worker invocation; /rpc serves the history (KV archive) and the moments when no
        // node answers. Calls: the dataseeds (they serve no logs at all). Logs: 48.club (250 blocks a
        // request), thirdweb (1000, an archive; it rate-limits bursts per address), publicnode (50000,
        // but logs older than about 2 to 2.5 hours come back empty with no error: trusted for 1 hour).
        // "keep": the hours of logs a pruning node is trusted for (48.club answered in full 2.5 to 100 h
        // back, 4 tries each, 2026-11-24: 6 like the judge; publicnode empty from about 2.5 h).
        // At most one request per node every 2 s per viewer on average (a burst of 3).
        "BROWSER_RPC_URLS": [
          { "url": "https://bsc-dataseed.bnbchain.org", "calls": true, "logs": 0 },
          { "url": "https://bsc-dataseed2.defibit.io", "calls": true, "logs": 0 },
          { "url": "https://bsc-dataseed1.ninicoin.io", "calls": true, "logs": 0 },
          { "url": "https://rpc-bsc.48.club", "logs": 250, "keep": 6 },
          { "url": "https://56.rpc.thirdweb.com", "logs": 1000, "archive": true },
          { "url": "https://bsc-rpc.publicnode.com", "logs": 50000, "keep": 1 }
        ],
        // the judge's log reads in requests of 1000 blocks: one request on thirdweb, four on 48.club
        "LOG_UNIT": 1000,
        // the widest range the site's proxy asks the log nodes for at once (thirdweb: four requests);
        // the history beyond it comes from the archive
        "SITE_LOG_SPAN": 4000,
        // the judge's chain requests a run: Workers Free allows 50 subrequests an invocation (KV calls
        // included); the archive after it takes what is left, at most 16 (src/archive.js), and sends
        // the archive node at most 7 requests a minute, the judge's own counted
        "SUBREQ_BUDGET": 45,
        "CHAIN_ID": 56,
        "ARENA": "0x3271fd3aBFbC24FCa71bC9E9019114F06d4b222E",
        "SEASON_BOOK": "0xc318F6135bE6d1efBa878203E5e70a3EB830d0b1",
        "SEASONS": { "1": { "plan": 12, "certificate": "0xE5C211DC07A1881Fdd1e18c7132C99735f2C7639" } },
        "RING": "green",
        "RINGS": { "red": "https://ibiti-agent-arena.drainshieldguard.workers.dev", "green": "https://ibiti-agent-arena-street.drainshieldguard.workers.dev" },
        "DECK": "workshop",
        "CHALLENGES": "open",
        "DECOYS": {
          "13": "0x6183FDE2C9Ce2787c9a07fcFF6C2c12e1929e6CA",
          "15": "0x01109635579e3EfB62114E917bbF14920BcA709A",
          "18": "0x80ca261f80f42de665f11dC993659F962e40d132",
          "21": "0x90Df74D55d67D16AB36AfB1A5e48cAa976B88065",
          "22": "0x016765309C4A9EFb6FC233b049959F891511ec78",
          "23": "0x0DeEAf3e3faf5Af64CD5170B4C28fb3c994AA5e1",
          "24": "0xEafbC1C1F1551CC191062F964BAB722387dA256C",
          "26": "0xb84e86c78736A2fae2181fb3D661354607aCc937",
          "27": "0x50151FE5c86ac70Ec3a99728EFb1b67EA1bab130"
        },
        "DEPLOY_BLOCK": 135473888,
        // blocks come every 0.45 s on mainnet too (measured 2026-11-24: 20000 blocks in 9003 s)
        "BLOCKS_PER_WEEK": 1343552,
        "ROUND_TIME": 60,
        "HALL_HOLD": 40
      }
    }
  }
}
