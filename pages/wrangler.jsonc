// The arena on Cloudflare (src/host.js). Public settings are vars; the season secret is a Worker
// secret (`wrangler secret put SECRET --env <name>`), never written here.
// Local run against a local node: `wrangler dev --env-file <file>` with RPC_URL, CHAIN_ID, ARENA,
// DECOYS and SECRET in that file (kept outside the project).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibiti-agent-arena",
  "main": "src/host.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "html_handling": "none",
    // the HTML pages get their link-preview tags from the Worker; every other file is served as is
    "run_worker_first": ["/", "/*.html"]
  },
  "observability": { "enabled": true },
  "vars": {
    "ROUND_TIME": 60,
    "DEPLOY_BLOCK": 0,
    "BLOCKS_PER_WEEK": 604800
  }
}
