// The arena on Cloudflare (src/host.js). Public settings are vars; the season secret and the judge's
// key are Worker secrets (`wrangler secret put SECRET` / `JUDGE_KEY --env <name>`), never written here.
// Local run against a local node: `wrangler dev --env-file <file>` with RPC_URL, CHAIN_ID, ARENA,
// DECOYS and SECRET in that file (kept outside the project).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibiti-agent-arena",
  "main": "src/host.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "html_handling": "none",
    // the HTML pages get their link-preview tags from the Worker; every other file is served as is
    "run_worker_first": ["/", "/*.html"]
  },
  // logs never keep a request's query string (a fighter's page key travels there) and no
  // per-request invocation logs are kept: only what the code itself logs (the judge's lines)
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
  // each visitor's reads through /rpc: the site polls every 2 s with a few calls; far more is not a viewer
  "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  // the judge: every minute it scores the fights that are over (src/judge-cron.js)
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ROUND_TIME": 60,
    "DEPLOY_BLOCK": 0,
    "BLOCKS_PER_WEEK": 604800
  },
  "env": {
    // the rehearsal on BNB Smart Chain Testnet (chain 97). Its judge is the rehearsal wallet; the key
    // and the season secret are uploaded as secrets from outside the project (--secrets-file).
    "testnet": {
      "name": "ibiti-agent-arena-testnet",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
      "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
      "vars": {
        // publicnode: the only public testnet node that serves logs over wide block ranges
        "RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "CHAIN_ID": 97,
        // the season: its number and its contract (the ranking, the close, the certificates)
        "SEASON": 3,
        "CERTIFICATE": "0x23f5A86066FD079Fc672760D52eDF02F60047919",
        // earlier arenas of this site: their fights stay readable by links that name them
        "ARCHIVE": [{ "arena": "0x270AC84667B4992C72369843bd141702d804a43C", "season": 2, "plan": 7, "deployBlock": 144213945, "certificate": "0x2B67588B385B9B429A9137D368E5B615d417AAaf", "decoys": {"13":"0xb629fB2b6ca32E21fb06467e905CB10009F0f787","15":"0x7C517758754D69600e4d60e64Ef305F61616e669","18":"0x1EBc643f26F173372f15497cc0F27693ABd18514","21":"0xd837218dB771F7cfF8977e924130a97c4586b377","22":"0xa9772CDa390BBE9AF9B34A86c04a562123291F6C","23":"0xDF111209587433a88daA6B802125C12A8E760646","24":"0xdFeCF3CF2E7041a9861dda6Ee4bE6df085B07e5b","26":"0x3Ad41BF8575898bD18E244A4f2a4a2b4E22cff49","27":"0x663b00b1b80BBE00e450fEaAb4C6487b0eCca7d0"} }, { "arena": "0x8080D34E5Ec0f91E8ed76Ef4d07b36Db8a32991f", "season": 1, "plan": 6, "deployBlock": 144116164, "certificate": "0xd239F9FC04303eE9CA6CB28755F093C40063c0c4", "decoys": {"13":"0x2a337235527eC38400A837591e928d4402a20ee7","15":"0xA2C51B9115A4312Ab7836B751b55878a0d893FD5","18":"0x3702C5e2bdD3E8cb86F638E5d8A667f2047BfbDD","21":"0x5154B5CDbc784aF43f673C3737d56C82067Bf125","22":"0xc41bbd20771f7D8Bc80C22E426E4725BE9D4da54","23":"0x8A38f5Ef6D4d985104772ae098FD4D7fE9CAF47A","24":"0xD949f6bDdfd6d677b3090c438fd8C8746ae41a26","26":"0x11a703B6153ECDE8DCCE65C3Dfd64e5e5894e7A9","27":"0x67bb6275326F5E3e188B09D8B89004aEb4d84C3C"} }, { "arena": "0x4984B4C6050ec3289907cfeb591E1f6a6Aa906ee", "plan": 6, "deployBlock": 144108862, "certificate": "0x09DA8087Ef6c8A7D35d1D675618A17A9FBB9304F", "decoys": {"13":"0xE291E72C560959bcd0648c28085D267cb72b9A74","15":"0x0D0319a95A291e67C4DD3026CF8781aaeF33876E","18":"0x2B165cD278492D100F4Ca05eD1F984b77C1309A8","21":"0x49C2E652653e5A209551037A2B7cF9285D06Fa65","22":"0x6EC7727122D5017FAB1a3C60248aC1C9b109E922","23":"0xAc2E8B51976E0cF3ca26A899B5a2c5E8180CB97c","24":"0xEfa39cDd4f1b2feB709bd7c30c23eDDA58Bb5152","26":"0x91e12A0a69eDC4f37047Eaa51F9ACe77F25a1042","27":"0x773881f4D2aF8A2CA78AB96f1961C1bfBFDf0A85"} }],
        "ARENA": "0xF09FF6CeBd45999847ad84D3170928d1e1d8c90e",
        // the two rings: this one (red, the season) and the green one (free fights, new tasks)
        "RING": "red",
        "RINGS": { "red": "https://ibiti-agent-arena-testnet.drainshieldguard.workers.dev", "green": "https://ibiti-agent-arena-testnet-green.drainshieldguard.workers.dev" },
        "DECOYS": {
          "13": "0xB548422318B9fCD2F202fC7C29d5F2E79167073a",
          "15": "0x584c5Af287b416e3ADe8eD59E7A67331fBF4F786",
          "18": "0xf520B0d56dc5eA8e3180D790069A0044cAEe24d2",
          "21": "0xA0E81F596Cbc73fF9F2949D41D8fb1beA2f0A124",
          "22": "0xA21151B4BDef3C59D0fc04477A1931C272B736a5",
          "23": "0xdD7180AD31699FEde6F0803eBfBd0684aFabAf76",
          "24": "0x4be151760c95a557233b281e547346F2c10e2152",
          "26": "0xAe5554E756f6F3Cbfc926AA2ff5fD91e743630FC",
          "27": "0x5F01aDf1983E71C70cF7f628d791460adbc49788"
        },
        "DEPLOY_BLOCK": 144286208,
        // blocks come every 0.45 s on the testnet (measured 2026-11-21: 2000 blocks in 901 s)
        "BLOCKS_PER_WEEK": 1342500,
        "ROUND_TIME": 60
      }
    },
    // the green ring on the testnet: free fights, challenges allowed, the workshop deck (new tasks on
    // trial). Its own arena, judge (a second rehearsal wallet: two judges never share a nonce) and secret.
    "testnet-green": {
      "name": "ibiti-agent-arena-testnet-green",
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false } },
      "ratelimits": [{ "name": "RPC_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }],
      "vars": {
        "RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "CHAIN_ID": 97,
        "SEASON": 1,
        "CERTIFICATE": "0x201D0e6A1efE0E6fc3715f12F27e72105A2bA624",
        "ARENA": "0xB739F4311337f6D2657d877305A07203f5D412F5",
        "RING": "green",
        "RINGS": { "red": "https://ibiti-agent-arena-testnet.drainshieldguard.workers.dev", "green": "https://ibiti-agent-arena-testnet-green.drainshieldguard.workers.dev" },
        "DECK": "workshop",
        "CHALLENGES": "open",
        "DECOYS": {
          "13": "0x85C02842AC2835b7c0981D17d649153E79106Fdb",
          "15": "0x474eC1c30185dFFEe3dCC944c4bE44343DCAC52d",
          "18": "0xa316bD849939eA2c407befF8b2818379fe399eED",
          "21": "0x7413d39e93De6e53DF8dAFe48DdE58717a413391",
          "22": "0x93Ce9463D8D6DFbBf7a9EFEea5b613AF3f3f10b7",
          "23": "0xBa1B2303833dd78C7b94BBe23f4b5e1FEF7F7638",
          "24": "0x6A68bFAF539c10552F370cA462551C5aeca1A07C",
          "26": "0xa945415f018ff9d88408748b26E3700842127897",
          "27": "0x4A22277500C9f5c539736938Efd194D46bDaCFEd"
        },
        "DEPLOY_BLOCK": 144286728,
        "BLOCKS_PER_WEEK": 1342500,
        "ROUND_TIME": 60
      }
    }
  }
}
